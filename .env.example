# Copy this file to `.env` and fill in the paths for your machine, then either
#   set -a; source .env; set +a
# or export each variable directly before running any script in this repo.
#
# Every variable below points at externally-managed data (raw/converted WSIs, Xenium
# instrument output, extracted embeddings, model checkpoints, ...) that is not part of
# this repo and differs machine-to-machine / user-to-user. See
# src/python/code_configs/paths.py for how these are consumed, and the top-level
# README's "Environment variables" section for which pipeline stage needs which
# variable. You only need to set the ones the script you're running actually touches --
# each is looked up lazily and raises a clear error naming itself if missing.

# ── Extracted embeddings / training outputs ─────────────────────────────────────────
# Root where extract_embeddings.py writes embeddings_dataset.h5 files, and where
# classifier_training / deepspot_training read them from (configs/*.yaml: data.base_dir):
#   $DATASETS_ROOT/{model_name}_h5/{correction_name}/{wsi}/embeddings_dataset.h5
DATASETS_ROOT=

# ── Xenium / H&E source data ─────────────────────────────────────────────────────────
# Per-sample processed Xenium pipeline output: $XENIUM_PROCESSED_OUTPUT_ROOT/{sample}/
# patch_coordinates.h5 (ground-truth cell positions/types) and .../{sample}/adata.h5ad
# (gene-expression AnnData, used by deepspot_training via configs/*.yaml's
# data.adata_path_template).
XENIUM_PROCESSED_OUTPUT_ROOT=

# Root of raw H&E whole-slide images: $WSI_RAW_ROOT/{wsi_filename}.
WSI_RAW_ROOT=

# Root of converted/registered H&E whole-slide images.
WSI_CONVERTED_ROOT=

# Root of raw per-sample Xenium instrument output: nucleus_boundaries.parquet,
# cell_boundaries.csv.gz, experiment.xenium. Used by extract_embeddings.py
# (ResizedCellDataset) and src/python/ot/centering_correction.py.
XENIUM_OUTPUT_ROOT=

# Root of per-sample Xenium<->H&E affine alignment matrices:
# $ALIGNMENT_MATRIX_ROOT/{sample}_he_imagealignment.csv.
ALIGNMENT_MATRIX_ROOT=

# ── CellViT <-> Xenium matching (src/python/ot/) ─────────────────────────────────────
# CellViT-centroid-corrected patch_coordinates.h5: same schema as
# XENIUM_PROCESSED_OUTPUT_ROOT's ground truth, but with x_start/y_start recomputed from
# the matched CellViT nucleus's own centroid. Read by extract_embeddings.py, written by
# src/python/ot/export_matched_patch_coordinates.py.
POSITIONS_CONVERTED_ROOT=

# Root of CellViT nucleus-segmentation cells.geojson outputs. Used only by
# src/python/ot/centering_correction.py.
CELLVIT_GEOJSON_OUTPUT_ROOT=

# ── Model checkpoints / access tokens ────────────────────────────────────────────────
# Directory containing CellViT checkpoint files (CellViT-SAM-H-x40-AMP.pth,
# CellViT-256-x40-AMP.pth).
CELLVIT_CACHE=

# Full path to the CTransPath checkpoint file (ctranspath.pth).
CTRANSPATH_WEIGHTS=

# Hugging Face access token, required for gated model downloads (CONCH; UNI2, Virchow2
# and H-optimus-1 also live behind gated HF repos and are typically downloaded once
# with `huggingface-cli login` using the same token).
HF_TOKEN=
