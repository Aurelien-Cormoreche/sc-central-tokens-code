#!/bin/bash
# Generated by bench (bench/jobs.py::write_sbatch). One array task = one bin of the plan.
#SBATCH --job-name={name}
#SBATCH --array={array}
#SBATCH --time={time}
#SBATCH --cpus-per-task={cpus}
#SBATCH --mem={mem}G
#SBATCH --output={log_dir}/task_%a.log
{options}

cd {repo}
{setup}
set -eo pipefail
echo "host=$(hostname) job=$SLURM_ARRAY_JOB_ID task=$SLURM_ARRAY_TASK_ID start=$(date -Is)"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || true
{python} -m bench run-bin --plan {plan_dir} --bin "$SLURM_ARRAY_TASK_ID"
echo "end=$(date -Is)"
